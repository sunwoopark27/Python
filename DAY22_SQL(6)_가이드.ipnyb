   "source": [
    "# country 테이블에서\n",
    "# GovernmentForm 필드의 데이터를 내림차순으로 정렬하여 조회\n",
    "cur.execute(\"SELECT * FROM country ORDER BY GovernmentForm DESC\")\n",
    "one = cur.fetchall()\n",
    "columns = [col[0] for col in cur.description]\n",
    "df_one = pd.DataFrame(one, columns = columns)\n",
    "df_one.head()"
   ]
