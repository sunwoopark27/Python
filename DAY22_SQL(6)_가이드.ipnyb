      ],
      "text/plain": [
       "            Region  count_reg\n",
       "0   Eastern Africa         20\n",
       "1      Middle East         18\n",
       "2   Western Africa         17\n",
       "3  Southern Europe         15"
      ]
     },
     "execution_count": 17,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "# country 테이블에서 Region 필드로 그룹화하고\n",
    "# 나라의 개수가 15이상 20이하인 데이터를 count_reg로 하여 내림차순으로 조회\n",
    "cur.execute(\"\"\"SELECT Region, COUNT(Region) AS count_reg \n",
    "            FROM country \n",
    "            GROUP BY Region \n",
    "            HAVING count_reg BETWEEN 15 AND 20 \n",
    "            ORDER BY count_reg DESC\"\"\")\n",
    "five = cur.fetchall()\n",
    "columns = [col[0] for col in cur.description]\n",
    "df_five = pd.DataFrame(five, columns = columns)\n",
    "df_five.head()"
   ]
  },
