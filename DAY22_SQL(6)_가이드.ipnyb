   "source": [
    "# country 테이블에서\n",
    "# GovernmentForm 필드 기준으로 내림차순으로 정렬한 후\n",
    "# SurfaceArea 필드 기준으로 오름차순 정렬하여 조회\n",
    "cur.execute(\"SELECT * FROM country ORDER BY GovernmentForm DESC, SurfaceArea\")\n",
    "two = cur.fetchall()\n",
    "columns = [col[0] for col in cur.description]\n",
    "df_two = pd.DataFrame(two, columns = columns)\n",
    "df_two.head()"
   ]
  },
