   "outputs": [],
   "source": [
    "import pymysql\n",
    "conn = pymysql.connect(\n",
    "    host = 'localhost',\n",
    "    port = 3306,\n",
    "    user = 'root',\n",
    "    password ='0000',\n",
    "    db = 'world',\n",
    "    charset ='utf8mb4')\n",
    "\n",
    "cur = conn.cursor()"
   ]
