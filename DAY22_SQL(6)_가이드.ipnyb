   "source": [
    "# country 테이블에서 Continent 필드로 그룹화하고\n",
    "# GNP 평균값을 소수점 2자로 반올림하여 조회하고 이름을 avg_GNP로 출력\n",
    "cur.execute(\"SELECT Continent, ROUND(AVG(GNP),2) AS avg_GNP FROM country GROUP BY Continent\")\n",
    "four = cur.fetchall()\n",
    "columns = [col[0] for col in cur.description]\n",
    "df_four = pd.DataFrame(four, columns = columns)\n",
    "df_four.head()"
   ]
  },
