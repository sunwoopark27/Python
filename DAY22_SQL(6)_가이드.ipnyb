   "source": [
    "# country 테이블의 각 국가마다\n",
    "# 해당 국가에 소속된 도시들의 평균 인구를 city 테이블을 이용하여 조회\n",
    "cur.execute(\"\"\"SELECT t.Name, AVG(c.Population)\n",
    "            FROM country t JOIN city c ON t.Code = c.CountryCode \n",
    "            GROUP BY t.Name\"\"\")\n",
    "six = cur.fetchall()\n",
    "columns = [col[0] for col in cur.description]\n",
    "df_six = pd.DataFrame(six, columns = columns)\n",
    "df_six.head()"
   ]
  },
