   "source": [
    "# country 테이블에서\n",
    "# Continent 필드가 'Africa'인 데이터 중에\n",
    "# Population 기준으로 오름차순 정렬한 후\n",
    "# Name, Population 데이터\n",
    "cur.execute(\"SELECT * FROM country WHERE Continent = 'Africa' ORDER BY Population\")\n",
    "three = cur.fetchall()\n",
    "columns = [col[0] for col in cur.description]\n",
    "df_three = pd.DataFrame(three, columns = columns)\n",
    "df_three.head()"
   ]
  },
